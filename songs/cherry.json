    "verses": [
      {"text": "手のひらで震えたそれが", "translation": "손바닥에서 떨린 그것이"},
      {"text": "小さな勇気になっていたんだ", "translation": "작은 용기가 되어 있었어"},
      {"text": "絵文字は苦手だっただけど", "translation": "이모티콘은 서툴렀지만"},
      {"text": "君からだったらワクワクしちゃう", "translation": "너한테서 온 거라면 두근거려 버려"},
      {"text": "返事はすぐにしちゃ駄目だって", "translation": "답장은 바로 하면 안 된대"},
      {"text": "誰かに聞いた事あるけど", "translation": "누군가한테 들은 적 있지만"},
      {"text": "駆け引きなんて出来ないの", "translation": "밀당 같은 건 못 해"},
      {"text": "好きなのよ ah ah ah~", "translation": "좋아하는걸 ah ah ah~"},
      {"text": "恋しちゃったんだ", "translation": "사랑에 빠져 버렸어"},
      {"text": "多分気づいてないでしょう", "translation": "아마 눈치 못 챘겠지"},
      {"text": "星の夜願い込めて C.HE.RRY", "translation": "별이 뜬 밤 소원을 담아 C.HE.RRY"},
      {"text": "指先で送る君へのメッセージ", "translation": "손끝으로 보내는 너에게로의 메시지"},
      {"text": "桜が咲いているこの部屋から見えてる景色を全部", "translation": "벚꽃이 피어 있는 이 방에서 보이는 풍경을 전부"},
      {"text": "今君が感じた世界と", "translation": "지금 네가 느낀 세계와"},
      {"text": "10秒取り替えてもらうより", "translation": "10초 바꿔 받기보다"},
      {"text": "ほんの一行でも構わないんだ", "translation": "그저 한 줄이라도 괜찮아"},
      {"text": "君からの言葉が欲しいんだ", "translation": "너의 말이 갖고 싶어"},
      {"text": "嘘でも信じ続けられるの", "translation": "거짓말이라도 계속 믿을 수 있어"},
      {"text": "好きだから ah ah ah~", "translation": "좋아하니까 ah ah ah~"},
      {"text": "恋しちゃったんだ", "translation": "사랑에 빠져 버렸어"},
      {"text": "多分気づいてないでしょう", "translation": "아마 눈치 못 챘겠지"},
