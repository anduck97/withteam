[
  {
    "title": "Love so sweet",
    "artist": "Arashi",
    "schemaVersion": 2,
    "verses": [
      {"text": "輝いたのは鏡でも太陽でもなくて", "translation": "빛난 건 거울도 태양도 아니라"},
      {"text": "君だと気付いたときから", "translation": "너라는 걸 깨달은 그때부터"},
      {"text": "あの涙ぐむ雲のずっと上には微笑む月", "translation": "그 눈물 머금은 구름 저 위엔 미소 짓는 달"},
      {"text": "Love story またひとつ", "translation": "Love story 또 하나"},
      {"text": "傷ついた夢は 昨日の彼方へ", "translation": "상처 입은 꿈은 어제의 저편으로"},
      {"text": "空に響け 愛の歌", "translation": "하늘에 울려라 사랑의 노래"},
      {"text": "想い出ずっと ずっと忘れない空", "translation": "추억은 계속 계속 잊지 않을 하늘"},
      {"text": "ふたりが離れていっても", "translation": "두 사람이 멀어져 간다 해도"},
      {"text": "こんな好きな人に 出逢う季節二度とない", "translation": "이렇게 좋아하는 사람을 만나는 계절은 다시없어"},
      {"text": "光ってもっと最高のlady", "translation": "빛나며 더욱, 최고의 lady"},
      {"text": "きっとそっと想い届く", "translation": "분명 살며시 마음이 닿아"},
      {"text": "信じることがすべて Love so sweet", "translation": "믿는 것이 전부야 Love so sweet"},
      {"text": "そこからいつも見えるように", "translation": "그곳에서 늘 보이도록"},
      {"text": "この手を空に向け 広がる君との思い出", "translation": "이 손을 하늘로 향해, 펼쳐지는 너와의 추억"},
      {"text": "あの頑なで意地っ張りな僕を変えた君の手", "translation": "그 완고하고 고집 센 나를 바꾼 너의 손"},
      {"text": "Love story 歩き出す", "translation": "Love story 걷기 시작해"},
      {"text": "曲がりくねってた ふたつの旅路は", "translation": "구불구불했던 두 갈래 여정은"},
      {"text": "ここでひとつ 虹になれ", "translation": "여기서 하나가 되어 무지개가 되어라"},
      {"text": "想い出ずっと ずっと追いかけた夢", "translation": "추억은 계속 계속 좇아온 꿈"},
      {"text": "ふたりが遠くへ行っても", "translation": "두 사람이 멀리 간다 해도"},
      {"text": "どんな辛い夜も くじけそうな誓いでも", "translation": "아무리 괴로운 밤도 꺾일 것 같은 맹세라도"},
      {"text": "笑ってもっと最後のlady", "translation": "웃으며 더욱, 마지막의 lady"},
      {"text": "きっとそっと願い届く", "translation": "분명 살며시 소원이 닿아"},
      {"text": "明けない夜はないよ Love so sweet", "translation": "밝지 않는 밤은 없어 Love so sweet"},
      {"text": "伝えきれぬ愛しさは", "translation": "다 전하지 못한 사랑스러움은"},
      {"text": "花になって 街に降って", "translation": "꽃이 되어 거리에 내려"},
      {"text": "どこにいても君をここに感じてる", "translation": "어디에 있어도 너를 여기서 느끼고 있어"},
      {"text": "想い出ずっと", "translation": "추억은 계속"},
      {"text": "ずっと忘れない空", "translation": "계속 잊지 않을 하늘"},
      {"text": "ふたりが離れていっても", "translation": "두 사람이 멀어져 간다 해도"},
      {"text": "こんな好きな人に", "translation": "이렇게 좋아하는 사람을"},
      {"text": "出逢う季節二度とない", "translation": "만나는 계절은 다시없어"},
      {"text": "光ってもっと最高のlady", "translation": "빛나며 더욱, 최고의 lady"},
      {"text": "きっとそっと想い届く", "translation": "분명 살며시 마음이 닿아"},
      {"text": "信じることがすべて", "translation": "믿는 것이 전부야"},
      {"text": "明けない夜はないよ", "translation": "밝지 않는 밤은 없어"},
      {"text": "信じることがすべて Love so sweet", "translation": "믿는 것이 전부야 Love so sweet"}
