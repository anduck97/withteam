    "verses": [
      {"text": "じとつく春のエピローグ", "translation": "축축한 봄의 에필로그"},
      {"text": "さざめく僕の心模様", "translation": "소란스런 내 마음의 모양"},
      {"text": "晴れ間のないこの日々が", "translation": "맑게 갠 날이 없는 이 나날들이"},
      {"text": "君の輪郭をぼかす", "translation": "너의 모습을 흐리게 해"},
      {"text": "広がるDistance", "translation": "펼쳐지는 Distance"},
      {"text": "分かり合うことすら躊躇って", "translation": "서로 이해하려는 것조차 망설여지고"},
      {"text": "苛立つ My mind", "translation": "초조한 My mind"},
      {"text": "投げつけ合う言葉が", "translation": "서로 내던지는 말들이"},
      {"text": "ぶつかった瞬間", "translation": "부딪힌 순간"},
      {"text": "目が覚めるような桜色 舞った", "translation": "눈이 뜨일 것만 같은 벚꽃색 흩날려"},
      {"text": "やわらかな五月雨の中", "translation": "부드러운 오월비 속에서"},
      {"text": "僕たちは 笑っていたよ", "translation": "우리들은 웃고 있었어"},
      {"text": "全部 洗い流せば", "translation": "전부 씻어 흘려버리면"},
      {"text": "頬濡らす五月雨今", "translation": "뺨을 적시는 오월비 지금"},
      {"text": "また手を繋ぐ", "translation": "다시 손을 잡아"},
      {"text": "また立ち上がる", "translation": "또 다시 일어나"},
      {"text": "また走り出す", "translation": "또 달려 나아가"},
      {"text": "この胸の奥 確かめ 今", "translation": "이 가슴 깊은 곳 확인해 지금"},
      {"text": "また We'll be as one", "translation": "다시 We'll be as one"},
      {"text": "完璧に同じ", "translation": "완벽히 똑같아"},
      {"text": "ずっとそう思っていた", "translation": "늘 그렇게 생각해 왔어"},
      {"text": "募るすれ違い", "translation": "거듭되는 엇갈림"},
      {"text": "溜まる蟠り", "translation": "맺히는 마음의 감정"},
      {"text": "桜散って 側溝に詰まった花びら", "translation": "벚꽃이 흩날리고 도랑 끝에 쌓인 꽃잎들"},
      {"text": "まるで僕たちみたい", "translation": "마치 우리들같아"},
      {"text": "移ろうSeason", "translation": "지나가는 Season"},
      {"text": "何度だって一緒に越える This is Fate", "translation": "몇 번이고 같이 헤쳐 나가 This is Fate"},
      {"text": "ほどける My mind", "translation": "누그러지는 My mind"},
      {"text": "君とただこのまま空を見ていたい", "translation": "너와 그저 이대로 하늘을 바라보고 싶어"},
